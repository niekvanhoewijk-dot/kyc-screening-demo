# Copy to .env.local (never committed).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# replay (default) = serve recorded responses from fixtures/claude-cache/, no key needed.
# live = call the API (and record). The record scripts always run live.
DEMO_MODE=replay
DATABASE_PATH=./data/demo.sqlite
# The AI interviewer at /apply/interview (Phase 10). Set to false to hide it.
AGENT_ENABLED=true
