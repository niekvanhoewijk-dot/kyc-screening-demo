{
  "name": "kyc-screening-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Illustrative KYC/KYB screening demo. Not a regulated compliance system.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:golden": ".venv/bin/python3 -I tools/verify_golden.py",
    "setup:py": "python3 -m venv .venv && .venv/bin/pip install -q -r requirements-dev.txt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docs:samples": "node tools/make_sample_documents.mjs",
    "docs:record": "vitest run --config vitest.record.config.ts",
    "eval": "VITEST_INCLUDE='tools/eval/**/*.eval.ts' vitest run --config vitest.record.config.ts",
    "demo:reset": "VITEST_INCLUDE='tools/demo/reset.demo.ts' vitest run --config vitest.record.config.ts",
    "demo:record": "VITEST_INCLUDE='tools/demo/record.demo.ts' vitest run --config vitest.record.config.ts",
    "interview:record": "VITEST_INCLUDE='tools/interview/record.interview.ts' vitest run --config vitest.record.config.ts",
    "preflight": "node tools/preflight.mjs",
    "demo": "node tools/preflight.mjs && npm run demo:reset && next dev",
    "verify:records": "VITEST_INCLUDE='tools/records/verify.records.ts' vitest run --config vitest.record.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
